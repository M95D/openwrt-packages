#!/bin/sh /etc/rc.common
USE_PROCD=1

START=80
STOP=10

HIAWATHA_USER=hiawatha
HIAWATHA_GROUP=hiawatha

start_service() {
  procd_open_instance hiawatha
  procd_set_param user $HIAWATHA_USER
  procd_set_param group $HIAWATHA_GROUP
  procd_set_param command /usr/sbin/hiawatha -d
  procd_set_param stderr 1
  procd_set_param stdout 1
  procd_close_instance
  }
